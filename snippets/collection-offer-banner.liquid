{%- doc -%}
  Renders an in-grid offer banner for collection product grids.

  @param {number} index - Banner number used for CSS hooks
  @param {number} columns - Desktop grid column span
  @param {object} image - Banner image
  @param {string} heading - Banner heading
  @param {string} text - Banner rich text
  @param {string} button_label - Button label
  @param {string} link - Banner link
  @param {string} background - Background color
  @param {string} text_color - Text color
{%- enddoc -%}

<li
  class="product-grid__item collection-offer-banner collection-offer-banner--{{ index }}"
  data-page="1"
  ref="cards[]"
  style="
    --collection-offer-banner-columns: {{ columns }};
    --collection-offer-banner-background: {{ background }};
    --collection-offer-banner-text: {{ text_color }};
  "
>
  {% if link != blank %}
    <a
      class="collection-offer-banner__inner"
      href="{{ link }}"
    >
  {% else %}
    <div class="collection-offer-banner__inner">
  {% endif %}
    <div class="collection-offer-banner__content">
      {% if heading != blank %}
        <h2 class="collection-offer-banner__heading">{{ heading }}</h2>
      {% endif %}

      {% if text != blank %}
        <div class="collection-offer-banner__text">
          {{ text }}
        </div>
      {% endif %}

      {% if button_label != blank %}
        <span class="collection-offer-banner__button">
          {{ button_label }}
        </span>
      {% endif %}
    </div>

    {% if image != blank %}
      {{
        image
        | image_url: width: 1400
        | image_tag:
          class: 'collection-offer-banner__image',
          widths: '375, 550, 750, 950, 1100, 1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'lazy'
      }}
    {% endif %}
  {% if link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</li>
