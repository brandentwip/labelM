    "custom_liquid_FgaiWJ": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Foundational Hair Health — video (left) / text (right) split\n  Fully scoped version: every selector lives under .fhh-wrap-{{ section.id }}\n  so it cannot leak out and affect the rest of the theme.\n  Paste this whole block into a \"Custom Liquid\" section.\n{%- endcomment -%}\n\n<div class=\"fhh-wrap-{{ section.id }}\">\n\n  <section class=\"fhh-section\">\n\n    <div class=\"fhh-video\">\n      <video class=\"fhh-video-el\" autoplay muted loop playsinline>\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/5c58e4d9394440fba5d17712f40410a6.mp4\" type=\"video/mp4\">\n      </video>\n      <div class=\"fhh-video-fallback\"></div>\n\n      <div class=\"fhh-controls\">\n        <button class=\"fhh-ctrl\" type=\"button\" data-fhh-mute aria-label=\"Toggle sound\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon>\n            <path d=\"M19 5a10 10 0 0 1 0 14\"></path>\n            <path d=\"M15.5 8.5a5 5 0 0 1 0 7\"></path>\n          </svg>\n        </button>\n        <button class=\"fhh-ctrl\" type=\"button\" data-fhh-play aria-label=\"Play or pause\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"6\" y=\"4\" width=\"4\" height=\"16\"></rect>\n            <rect x=\"14\" y=\"4\" width=\"4\" height=\"16\"></rect>\n          </svg>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"fhh-text\">\n      <h2 class=\"fhh-heading\">Foundational<br>Hair Health</h2>\n      <p class=\"fhh-subheading\">Your great hair days are rooted in molecular bond science.</p>\n      <a href=\"https://labelm-2.myshopify.com/pages/about-us\" class=\"fhh-cta\">Learn More</a>\n\n      <ul class=\"fhh-benefits\">\n        <li>Strength &amp; Elasticity</li>\n        <li>Shine &amp; Sheen</li>\n        <li>Smoothness &amp; Frizz Control</li>\n        <li>Softness &amp; Moisturization</li>\n        <li>Shape Retention &amp; Integrity</li>\n      </ul>\n    </div>\n\n  </section>\n\n</div>\n\n<style>\n  .fhh-wrap-{{ section.id }} {\n    --fhh-ink: #111111;\n    --fhh-paper: #ffffff;\n    --fhh-accent: #b2a373;\n    --fhh-muted: #3d3d3d;\n    display: block;\n    width: 100%;\n    max-width: 100%;\n    overflow-x: hidden;\n    box-sizing: border-box;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-section {\n    box-sizing: border-box;\n    border-top: 3px solid var(--fhh-accent);\n    display: flex;\n    width: 100%;\n    max-width: 100%;\n    min-height: 620px;\n    background: var(--fhh-paper);\n    color: var(--fhh-ink);\n    font-family: inherit;\n    overflow: hidden;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-section,\n  .fhh-wrap-{{ section.id }} .fhh-section * {\n    box-sizing: border-box;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-video {\n    position: relative;\n    flex: 0 0 60%;\n    max-width: 60%;\n    min-width: 0;\n    background: #efece6;\n    overflow: hidden;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-video-fallback,\n  .fhh-wrap-{{ section.id }} .fhh-video-el {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    margin: 0;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-video-el {\n    z-index: 1;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-video-fallback {\n    z-index: 0;\n    background:\n      radial-gradient(ellipse 60% 45% at 50% 8%, #d8c9a3 0%, transparent 60%),\n      linear-gradient(180deg, #f2efe9 0%, #e7e0d2 45%, #17140f 100%);\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-controls {\n    position: absolute;\n    bottom: 22px;\n    right: 24px;\n    display: flex;\n    gap: 10px;\n    z-index: 2;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-ctrl {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: rgba(255,255,255,0.92);\n    border: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    color: #111;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n    padding: 0;\n    margin: 0;\n    font: inherit;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-ctrl svg {\n    width: 18px;\n    height: 18px;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-text {\n    flex: 1 1 auto;\n    min-width: 0;\n    max-width: 480px;\n    padding: 56px 40px 40px 48px;\n    display: flex;\n    flex-direction: column;\n    margin: 0;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-heading {\n    font-size: clamp(28px, 4.2vw, 56px);\n    line-height: 1.05;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n    margin: 0 0 22px 0;\n    padding: 0;\n    color: var(--fhh-ink);\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n    -webkit-hyphens: none !important;\n    hyphens: none !important;\n    white-space: normal;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-subheading {\n    font-size: 17px;\n    line-height: 1.5;\n    color: var(--fhh-muted);\n    max-width: 340px;\n    margin: 0 0 26px 0;\n    padding: 0;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n    hyphens: none !important;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-cta {\n    display: inline-block;\n    align-self: flex-start;\n    padding: 14px 30px;\n    border: 1.5px solid var(--fhh-ink);\n    border-radius: 999px;\n    background: transparent;\n    color: var(--fhh-ink);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    cursor: pointer;\n    margin: 0 0 44px 0;\n    transition: background 0.2s ease, color 0.2s ease;\n    text-decoration: none;\n    text-align: center;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-cta:hover {\n    background: var(--fhh-ink);\n    color: var(--fhh-paper);\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-benefits {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin: 0;\n    padding: 0;\n  }\n\n  .fhh-wrap-{{ section.id }} .fhh-benefits li {\n    font-size: clamp(18px, 2.4vw, 30px);\n    line-height: 1.18;\n    font-weight: 800;\n    letter-spacing: -0.01em;\n    color: var(--fhh-ink);\n    margin: 0;\n    padding: 0;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n    hyphens: none !important;\n  }\n\n  @media (max-width: 900px) {\n    .fhh-wrap-{{ section.id }} .fhh-section {\n      flex-direction: column;\n    }\n    .fhh-wrap-{{ section.id }} .fhh-video {\n      max-width: 100%;\n      flex-basis: auto;\n      height: 60vh;\n    }\n    .fhh-wrap-{{ section.id }} .fhh-text {\n      padding: 36px 24px 48px;\n    }\n    .fhh-wrap-{{ section.id }} .fhh-heading {\n      font-size: 38px;\n    }\n    .fhh-wrap-{{ section.id }} .fhh-benefits li {\n      font-size: 22px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var wrap = document.currentScript.closest('.fhh-wrap-{{ section.id }}');\n    if (!wrap) return;\n    var video = wrap.querySelector('.fhh-video-el');\n    var muteBtn = wrap.querySelector('[data-fhh-mute]');\n    var playBtn = wrap.querySelector('[data-fhh-play]');\n    if (video && muteBtn) {\n      muteBtn.addEventListener('click', function () { video.muted = !video.muted; });\n    }\n    if (video && playBtn) {\n      playBtn.addEventListener('click', function () {\n        if (video.paused) { video.play(); } else { video.pause(); }\n      });\n    }\n  })();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
