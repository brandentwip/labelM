    "custom_liquid_BnANGY": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  EDIT THIS LIST to add/remove/reorder product slides.\n{% endcomment %}\n{% assign slide_handles = \"honey-oat-moisturising-conditioner|fashion-edition-heat-protection-mist\" | split: \"|\" %}\n{% assign slide_ratings = \"4.5|4.5\" | split: \"|\" %}\n{% assign slide_reviews = \"0|0\" | split: \"|\" %}\n{% assign slide_img_one = \"https://cdn.shopify.com/s/files/1/0992/8006/0736/files/honey_and_oat.jpg?v=1785222320|https://cdn.shopify.com/s/files/1/0992/8006/0736/files/heat-protection-mist-ambient-scaled.jpg?v=1785222320\" | split: \"|\" %}\n{% assign slide_img_two = \"https://cdn.shopify.com/s/files/1/0992/8006/0736/files/dcb1003b1b82712a7b59a9a6f62bea785eb51df3___media_library_original_336_336.jpg?v=1785222318|https://cdn.shopify.com/s/files/1/0992/8006/0736/files/b98b524bf465fccbda061d0e4ca1bcdc341e8893___media_library_original_480_480.jpg?v=1785222319\" | split: \"|\" %}\n\n<section class=\"pshow\" id=\"pshow-{{ section.id }}\">\n  <div class=\"pshow__inner\">\n\n    <div class=\"pshow__header\">\n      <h2 class=\"pshow__heading\">MEET THE NEW PRODUCT</h2>\n      <div class=\"pshow__nav pshow__nav--top\">\n        <button type=\"button\" class=\"pshow__arrow js-pshow-prev\" aria-label=\"Previous product\">\n          <svg width=\"9\" height=\"15\" viewBox=\"0 0 9 15\" fill=\"none\"><path d=\"M8 1L1.5 7.5L8 14\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </button>\n        <button type=\"button\" class=\"pshow__arrow js-pshow-next\" aria-label=\"Next product\">\n          <svg width=\"9\" height=\"15\" viewBox=\"0 0 9 15\" fill=\"none\"><path d=\"M1 1L7.5 7.5L1 14\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"pshow__body\">\n\n      <div class=\"pshow__info\">\n        <div class=\"pshow__info-stack\">\n          {% for handle in slide_handles %}\n            {% assign i = forloop.index0 %}\n            {% assign product = all_products[handle] %}\n            {% assign rating = slide_ratings[i] | default: 4.5 %}\n            {% assign reviews = slide_reviews[i] | default: 0 %}\n            {% assign rating_pct = rating | times: 20 %}\n            <div class=\"pshow__slide-info{% if forloop.first %} is-active{% endif %}\" data-pshow-index=\"{{ i }}\" {% unless forloop.first %}hidden{% endunless %}>\n              <a href=\"{{ product.url | default: '#' }}\" class=\"pshow__product-image\">\n                {% if product.featured_image %}\n                  <img src=\"{{ product.featured_image | image_url: width: 500 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\">\n                {% endif %}\n              </a>\n              <a href=\"{{ product.url | default: '#' }}\" class=\"pshow__product-title\">\n                {{ product.title | default: 'Product title' }}\n              </a>\n              <div class=\"pshow__rating\" aria-label=\"Rated {{ rating }} out of 5\">\n                <span class=\"pshow__stars\" style=\"--rating-pct: {{ rating_pct }}%;\">&#9733;&#9733;&#9733;&#9733;&#9733;</span>\n                {% if reviews != \"0\" %}<span class=\"pshow__review-count\">({{ reviews }})</span>{% endif %}\n              </div>\n              <div class=\"pshow__price\">\n                {% if product %}\n                  {% if product.compare_at_price > product.price %}\n                    <span class=\"pshow__price-sale\">{{ product.price | money }}</span>\n                    <span class=\"pshow__price-compare\">{{ product.compare_at_price | money }}</span>\n                  {% else %}\n                    {{ product.price | money }}\n                  {% endif %}\n                {% endif %}\n              </div>\n              {% if product %}\n                <a href=\"{{ product.url }}\" class=\"pshow__cta\">Shop now</a>\n              {% endif %}\n            </div>\n          {% endfor %}\n        </div>\n\n        <div class=\"pshow__pager\">\n          <div class=\"pshow__pager-track\"><div class=\"pshow__pager-fill js-pshow-fill\"></div></div>\n          <div class=\"pshow__nav pshow__nav--bottom\">\n            <button type=\"button\" class=\"pshow__arrow pshow__arrow--sm js-pshow-prev\" aria-label=\"Previous product\">\n              <svg width=\"7\" height=\"12\" viewBox=\"0 0 9 15\" fill=\"none\"><path d=\"M8 1L1.5 7.5L8 14\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </button>\n            <button type=\"button\" class=\"pshow__arrow pshow__arrow--sm js-pshow-next\" aria-label=\"Next product\">\n              <svg width=\"7\" height=\"12\" viewBox=\"0 0 9 15\" fill=\"none\"><path d=\"M1 1L7.5 7.5L1 14\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"pshow__images\">\n        {% for handle in slide_handles %}\n          {% assign i = forloop.index0 %}\n          <div class=\"pshow__slide-images{% if forloop.first %} is-active{% endif %}\" data-pshow-index=\"{{ i }}\" {% unless forloop.first %}hidden{% endunless %}>\n            <div class=\"pshow__img pshow__img--one\">\n              <img src=\"{{ slide_img_one[i] }}\" alt=\"\" loading=\"lazy\">\n            </div>\n            <div class=\"pshow__img pshow__img--two\">\n              <img src=\"{{ slide_img_two[i] }}\" alt=\"\" loading=\"lazy\">\n              {% if slide_handles.size > 1 %}\n                <div class=\"pshow__dots\">\n                  {% for dot in slide_handles %}\n                    <button type=\"button\" class=\"pshow__dot{% if forloop.first %} is-active{% endif %}\" data-pshow-goto=\"{{ forloop.index0 }}\" aria-label=\"Show product {{ forloop.index }}\"></button>\n                  {% endfor %}\n                </div>\n              {% endif %}\n            </div>\n          </div>\n        {% endfor %}\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  #pshow-{{ section.id }} {\n    --pshow-bg: #FFFFFF;\n    --pshow-text: #1A1A1A;\n    --pshow-accent: #3A3352;\n    --pshow-muted: #8A8A8A;\n    background: var(--pshow-bg);\n    color: var(--pshow-text);\n    padding: 48px 32px;\n  }\n\n  #pshow-{{ section.id }} [hidden] {\n    display: none !important;\n  }\n\n  #pshow-{{ section.id }} .pshow__inner { max-width: 1400px; margin: 0 auto; }\n  #pshow-{{ section.id }} .pshow__header {\n    display: flex; align-items: center; justify-content: space-between;\n    border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 20px; margin-bottom: 40px;\n  }\n  #pshow-{{ section.id }} .pshow__heading {\n    font-size: clamp(22px, 3vw, 34px); letter-spacing: 0.04em; font-weight: 500;\n    text-transform: uppercase; margin: 0;\n  }\n  #pshow-{{ section.id }} .pshow__nav { display: flex; gap: 22px; }\n  #pshow-{{ section.id }} .pshow__arrow {\n    background: none; border: none; padding: 4px; cursor: pointer;\n    color: var(--pshow-text); display: flex; align-items: center; justify-content: center;\n    transition: opacity 0.2s ease;\n  }\n  #pshow-{{ section.id }} .pshow__arrow:hover { opacity: 0.55; }\n  #pshow-{{ section.id }} .pshow__body {\n    display: grid; grid-template-columns: minmax(240px, 340px) 1fr; gap: 56px; align-items: center;\n  }\n\n  #pshow-{{ section.id }} .pshow__info { display: flex; flex-direction: column; }\n  #pshow-{{ section.id }} .pshow__info-stack { position: relative; overflow: hidden; }\n  #pshow-{{ section.id }} .pshow__images { position: relative; min-height: 320px; overflow: hidden; }\n\n  #pshow-{{ section.id }} .pshow__slide-info {\n    display: flex; flex-direction: column; align-items: flex-start;\n  }\n  #pshow-{{ section.id }} .pshow__slide-images {\n    display: flex; gap: 4px;\n  }\n\n  #pshow-{{ section.id }} .pshow__slide-info.is-sliding-next,\n  #pshow-{{ section.id }} .pshow__slide-images.is-sliding-next {\n    animation: pshowSlideFromRight 0.45s ease forwards;\n  }\n  #pshow-{{ section.id }} .pshow__slide-info.is-sliding-prev,\n  #pshow-{{ section.id }} .pshow__slide-images.is-sliding-prev {\n    animation: pshowSlideFromLeft 0.45s ease forwards;\n  }\n  @keyframes pshowSlideFromRight {\n    from { opacity: 0; transform: translateX(28px); }\n    to   { opacity: 1; transform: translateX(0); }\n  }\n  @keyframes pshowSlideFromLeft {\n    from { opacity: 0; transform: translateX(-28px); }\n    to   { opacity: 1; transform: translateX(0); }\n  }\n\n  #pshow-{{ section.id }} .pshow__product-image { display: block; margin-bottom: 28px; max-width: 220px; }\n  #pshow-{{ section.id }} .pshow__product-image img { width: 100%; height: auto; display: block; }\n  #pshow-{{ section.id }} .pshow__product-title {\n    font-size: 15px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;\n    text-decoration: none; color: var(--pshow-text); margin-bottom: 10px;\n  }\n  #pshow-{{ section.id }} .pshow__rating { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }\n  #pshow-{{ section.id }} .pshow__stars {\n    position: relative; display: inline-block; font-size: 16px; line-height: 1;\n    letter-spacing: 2px; color: rgba(0,0,0,0.18);\n  }\n  #pshow-{{ section.id }} .pshow__stars::before {\n    content: \"\\2605\\2605\\2605\\2605\\2605\"; position: absolute; top: 0; left: 0;\n    width: var(--rating-pct, 0%); overflow: hidden; white-space: nowrap; color: var(--pshow-accent);\n  }\n  #pshow-{{ section.id }} .pshow__review-count { font-size: 12px; color: var(--pshow-muted); }\n  #pshow-{{ section.id }} .pshow__price { font-size: 15px; color: var(--pshow-muted); margin-bottom: 22px; }\n  #pshow-{{ section.id }} .pshow__price-sale { color: var(--pshow-text); margin-right: 8px; }\n  #pshow-{{ section.id }} .pshow__price-compare { text-decoration: line-through; }\n  #pshow-{{ section.id }} .pshow__cta {\n    display: inline-block; padding: 13px 30px; border: 1px solid var(--pshow-text);\n    text-decoration: none; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;\n    color: var(--pshow-text); transition: background 0.2s ease, color 0.2s ease; margin-bottom: 28px;\n  }\n  #pshow-{{ section.id }} .pshow__cta:hover { background: var(--pshow-text); color: var(--pshow-bg); }\n  #pshow-{{ section.id }} .pshow__pager { display: flex; align-items: center; gap: 20px; margin-top: 8px; }\n  #pshow-{{ section.id }} .pshow__pager-track { width: 60px; height: 1px; background: rgba(0,0,0,0.15); position: relative; }\n  #pshow-{{ section.id }} .pshow__pager-fill {\n    position: absolute; top: 0; left: 0; height: 100%; width: 0%;\n    background: var(--pshow-text); transition: width 0.35s ease;\n  }\n  #pshow-{{ section.id }} .pshow__img { position: relative; overflow: hidden; background: #f2f2f2; }\n  #pshow-{{ section.id }} .pshow__img--one { flex: 1.15; }\n  #pshow-{{ section.id }} .pshow__img--two { flex: 1; }\n  #pshow-{{ section.id }} .pshow__img img { width: 100%; height: 100%; display: block; object-fit: cover; aspect-ratio: 3/4; }\n  #pshow-{{ section.id }} .pshow__dots { position: absolute; left: 20px; bottom: 20px; display: flex; gap: 8px; }\n  #pshow-{{ section.id }} .pshow__dot {\n    width: 9px; height: 9px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.85);\n    background: transparent; cursor: pointer; padding: 0; transition: background 0.2s ease;\n  }\n  #pshow-{{ section.id }} .pshow__dot.is-active { background: #fff; }\n\n  @media screen and (max-width: 989px) {\n    #pshow-{{ section.id }} .pshow__body { grid-template-columns: 1fr; gap: 32px; }\n    #pshow-{{ section.id }} .pshow__info { order: 2; }\n    #pshow-{{ section.id }} .pshow__images { order: 1; min-height: 0; }\n    #pshow-{{ section.id }} .pshow__product-image { max-width: 160px; }\n  }\n  @media screen and (max-width: 749px) {\n    #pshow-{{ section.id }} { padding: 32px 16px; }\n    #pshow-{{ section.id }} .pshow__header { margin-bottom: 28px; }\n    #pshow-{{ section.id }} .pshow__heading { font-size: 18px; letter-spacing: 0.02em; }\n    #pshow-{{ section.id }} .pshow__nav--top { display: none; }\n    #pshow-{{ section.id }} .pshow__slide-images { gap: 3px; }\n    #pshow-{{ section.id }} .pshow__product-image { max-width: 130px; margin-bottom: 18px; }\n    #pshow-{{ section.id }} .pshow__dots { left: 14px; bottom: 14px; }\n  }\n  @media screen and (max-width: 480px) {\n    #pshow-{{ section.id }} .pshow__img--one { display: none; }\n    #pshow-{{ section.id }} .pshow__img--two { flex: 1; }\n    #pshow-{{ section.id }} .pshow__img--two img { aspect-ratio: 4/5; }\n  }\n</style>\n\n<script>\n  (function () {\n    var root = document.getElementById('pshow-{{ section.id }}');\n    if (!root) return;\n    var infoSlides = root.querySelectorAll('.pshow__slide-info');\n    var imageSlides = root.querySelectorAll('.pshow__slide-images');\n    var dots = root.querySelectorAll('.pshow__dot');\n    var fill = root.querySelector('.js-pshow-fill');\n    var total = infoSlides.length;\n    var current = 0;\n\n    function clearSlideClasses(el) {\n      el.classList.remove('is-sliding-next', 'is-sliding-prev');\n    }\n\n    function show(index, direction) {\n      if (total === 0) return;\n      var next = (index + total) % total;\n      if (next === current && direction === undefined) return;\n      current = next;\n\n      infoSlides.forEach(function (el) {\n        var isActive = parseInt(el.getAttribute('data-pshow-index'), 10) === current;\n        el.hidden = !isActive;\n        el.classList.toggle('is-active', isActive);\n        clearSlideClasses(el);\n        if (isActive && direction) {\n          void el.offsetWidth;\n          el.classList.add(direction === 'next' ? 'is-sliding-next' : 'is-sliding-prev');\n        }\n      });\n\n      imageSlides.forEach(function (el) {\n        var isActive = parseInt(el.getAttribute('data-pshow-index'), 10) === current;\n        el.hidden = !isActive;\n        el.classList.toggle('is-active', isActive);\n        clearSlideClasses(el);\n        if (isActive && direction) {\n          void el.offsetWidth;\n          el.classList.add(direction === 'next' ? 'is-sliding-next' : 'is-sliding-prev');\n        }\n      });\n\n      dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === current); });\n      if (fill && total > 1) { fill.style.width = (((current + 1) / total) * 100) + '%'; }\n    }\n\n    root.querySelectorAll('.js-pshow-next').forEach(function (btn) {\n      btn.addEventListener('click', function () { show(current + 1, 'next'); });\n    });\n    root.querySelectorAll('.js-pshow-prev').forEach(function (btn) {\n      btn.addEventListener('click', function () { show(current - 1, 'prev'); });\n    });\n    dots.forEach(function (dot) {\n      dot.addEventListener('click', function () {\n        var target = parseInt(dot.getAttribute('data-pshow-goto'), 10);\n        show(target, target > current ? 'next' : 'prev');\n      });\n    });\n\n    show(0);\n  })();\n</script>",
