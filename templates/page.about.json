    "custom_liquid_PFeMwX": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Video (left) / Padded Image (right) split section\n  Fully scoped: every selector lives under .viw-wrap-{{ section.id }}\n  so it cannot leak out and affect the rest of the theme.\n\n  TO USE YOUR OWN MEDIA:\n  - Video: replace the <source src=\"...\"> URL below with your video file URL.\n  - Image: replace the <img src=\"...\"> URL below with your image URL.\n{%- endcomment -%}\n\n<div class=\"viw-wrap-{{ section.id }}\">\n  <section class=\"viw-section\">\n\n    <div class=\"viw-video\">\n      <video class=\"viw-video-el\" autoplay muted loop playsinline>\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/c167ea87d3394f89be3978b1ede01e4b.mp4\" type=\"video/mp4\">\n      </video>\n      <div class=\"viw-video-fallback\"></div>\n    </div>\n\n    <div class=\"viw-image-col\">\n      <div class=\"viw-image-frame\">\n        <img class=\"viw-image\" src=\"https://cdn.shopify.com/s/files/1/0992/8006/0736/files/030a2144e6f64b0c290240eb2995ff7717d9703e___media_library_original_1254_705.png?v=1784807064\" alt=\"\">\n      </div>\n    </div>\n\n  </section>\n</div>\n\n<style>\n  .viw-wrap-{{ section.id }} {\n    --viw-paper: #ffffff;\n    --viw-frame-bg: #f4f2ee;\n    display: block;\n    width: 100%;\n    max-width: 100%;\n    overflow-x: hidden;\n    box-sizing: border-box;\n  }\n\n  .viw-wrap-{{ section.id }} .viw-section,\n  .viw-wrap-{{ section.id }} .viw-section * {\n    box-sizing: border-box;\n  }\n\n  .viw-wrap-{{ section.id }} .viw-section {\n    display: flex;\n    align-items: stretch;\n    width: 100%;\n    max-width: 100%;\n    min-height: 560px;\n    background: var(--viw-paper);\n    overflow: hidden;\n  }\n\n  /* ---- Video (left, edge to edge) ---- */\n  .viw-wrap-{{ section.id }} .viw-video {\n    position: relative;\n    flex: 0 0 50%;\n    max-width: 50%;\n    min-width: 0;\n    background: #efece6;\n    overflow: hidden;\n  }\n\n  .viw-wrap-{{ section.id }} .viw-video-el,\n  .viw-wrap-{{ section.id }} .viw-video-fallback {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    margin: 0;\n  }\n\n  .viw-wrap-{{ section.id }} .viw-video-el { z-index: 1; }\n\n  .viw-wrap-{{ section.id }} .viw-video-fallback {\n    z-index: 0;\n    background:\n      radial-gradient(ellipse 60% 45% at 50% 8%, #d8c9a3 0%, transparent 60%),\n      linear-gradient(180deg, #f2efe9 0%, #e7e0d2 45%, #17140f 100%);\n  }\n\n  /* ---- Image (right, padded / inset) ---- */\n  .viw-wrap-{{ section.id }} .viw-image-col {\n    flex: 1 1 auto;\n    min-width: 0;\n    display: flex;\n    align-items: stretch;\n    background: var(--viw-frame-bg);\n  }\n\n  .viw-wrap-{{ section.id }} .viw-image-frame {\n    width: 100%;\n    padding: 48px;\n    display: flex;\n  }\n\n  .viw-wrap-{{ section.id }} .viw-image {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n    border-radius: 4px;\n  }\n\n  @media (max-width: 900px) {\n    .viw-wrap-{{ section.id }} .viw-section {\n      flex-direction: column;\n      min-height: 0;\n    }\n    .viw-wrap-{{ section.id }} .viw-video {\n      max-width: 100%;\n      flex-basis: auto;\n      height: 60vh;\n    }\n    .viw-wrap-{{ section.id }} .viw-image-col {\n      max-width: 100%;\n      flex-basis: auto;\n    }\n    .viw-wrap-{{ section.id }} .viw-image-frame {\n      padding: 24px;\n    }\n    .viw-wrap-{{ section.id }} .viw-image {\n      height: 320px;\n    }\n  }\n</style>",
