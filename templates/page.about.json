      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Empowering You — bold headline (left) / paragraph copy (right) split\n  Fully scoped: every selector lives under .etx-wrap-{{ section.id }}\n  so it cannot leak out and affect the rest of the theme.\n{%- endcomment -%}\n\n<div class=\"etx-wrap-{{ section.id }}\">\n  <section class=\"etx-section\">\n\n    <div class=\"etx-heading-col\">\n      <h2 class=\"etx-heading\">Empowering <br> You Unapologetically <br> You</h2>\n    </div>\n\n    <div class=\"etx-text-col\">\n      <p class=\"etx-copy\">Label.M isn't just haircare, it's a breakthrough for your hair. Our high-performance products are designed to understand and flatter the unique characteristics of Indian hair, from texture to density. Unleash your hair's hidden potential and experience the Label.M difference — it's all about you and your best hair ever.</p>\n    </div>\n\n  </section>\n</div>\n\n<style>\n  .etx-wrap-{{ section.id }} {\n    --etx-ink: #000000;\n    --etx-copy: #8c8c8c;\n    --etx-paper: #ffffff;\n    display: block;\n    width: 100%;\n    max-width: 100%;\n    overflow-x: hidden;\n    box-sizing: border-box;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-section,\n  .etx-wrap-{{ section.id }} .etx-section * {\n    box-sizing: border-box;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-section {\n    display: flex;\n    align-items: center;\n    width: 100%;\n    max-width: 100%;\n    background: var(--etx-paper);\n    padding: 64px 56px;\n    gap: 48px;\n    overflow: hidden;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-heading-col {\n    flex: 0 0 56%;\n    max-width: 56%;\n    min-width: 0;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-heading {\n    margin: 0;\n    padding: 0;\n    text-align: right;\n    text-transform: uppercase;\n    font-weight: 800;\n    font-style: normal;\n    font-stretch: condensed;\n    letter-spacing: -0.01em;\n    line-height: 0.98;\n    color: var(--etx-ink);\n    font-size: clamp(28px, 4.6vw, 58px);\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n    hyphens: none !important;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-text-col {\n    flex: 1 1 auto;\n    min-width: 0;\n    max-width: 480px;\n  }\n\n  .etx-wrap-{{ section.id }} .etx-copy {\n    margin: 0;\n    padding: 0;\n    font-size: 18px;\n    line-height: 1.6;\n    color: var(--etx-copy);\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n    hyphens: none !important;\n  }\n\n  @media (max-width: 900px) {\n    .etx-wrap-{{ section.id }} .etx-section {\n      flex-direction: column;\n      align-items: flex-start;\n      padding: 40px 24px;\n      gap: 24px;\n    }\n    .etx-wrap-{{ section.id }} .etx-heading-col,\n    .etx-wrap-{{ section.id }} .etx-text-col {\n      max-width: 100%;\n      flex: 0 0 auto;\n    }\n    .etx-wrap-{{ section.id }} .etx-heading {\n      text-align: left;\n      font-size: 34px;\n    }\n    .etx-wrap-{{ section.id }} .etx-copy {\n      font-size: 16px;\n    }\n  }\n</style>",
