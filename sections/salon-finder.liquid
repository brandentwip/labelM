    // Process stores to add map URLs
    stores.forEach(store => {
      // Create a Google Maps search URL based on the store's address
      const addressQuery = encodeURIComponent(`${store.Name}, ${store.Address}, ${store.City}, ${store.State}, ${store.Zip}, ${store.Country}`);
      store.maps = `https://www.google.com/maps/search/?api=1&query=${addressQuery}`;
    });
    
    // Get unique cities for filters
    function getUniqueCities() {
      const cities = new Set();
      stores.forEach(store => {
        if (store.City) {
          cities.add(store.City);
        }
      });
      return Array.from(cities).sort();
    }
    
    // Create city filter buttons and dropdown
    function createCityFilters() {
      const cities = getUniqueCities();
      const filterContainer = document.getElementById("cityFilters");
      const cityDropdown = document.getElementById("cityDropdown");
      
      // Add "All Cities" button
      const allButton = document.createElement("button");
      allButton.classList.add("filter-btn", "active");
      allButton.textContent = "All Cities";
      allButton.dataset.city = "all";
      filterContainer.appendChild(allButton);
      
      // Add buttons for each city
      cities.forEach(city => {
        const button = document.createElement("button");
        button.classList.add("filter-btn");
        button.textContent = city;
        button.dataset.city = city;
        filterContainer.appendChild(button);
        
        // Add option to dropdown
        const option = document.createElement("option");
        option.value = city;
        option.textContent = city;
        cityDropdown.appendChild(option);
      });
      
      // Add event listeners to filter buttons
      const filterButtons = document.querySelectorAll(".filter-btn");
      filterButtons.forEach(button => {
        button.addEventListener("click", () => {
          // Remove active class from all buttons
          filterButtons.forEach(btn => btn.classList.remove("active"));
          // Add active class to clicked button
          button.classList.add("active");
          // Filter stores by selected city
          filterStores();
          // Scroll to store list
          scrollToStoreList();
        });
      });
      
      // Add event listener to dropdown
      cityDropdown.addEventListener("change", () => {
        const selectedCity = cityDropdown.value;
        // Update active button in desktop view
        filterButtons.forEach(btn => {
          if (btn.dataset.city === selectedCity) {
            btn.classList.add("active");
          } else {
            btn.classList.remove("active");
          }
        });
        // Filter stores
        filterStores();
        // Scroll to store list
        scrollToStoreList();
      });
    }
    
    // Function to scroll to store list
    function scrollToStoreList() {
      document.getElementById("storeList").scrollIntoView({ behavior: 'smooth' });
    }
    
    // Display stores in the UI
    function displayStores(list) {
      const storeList = document.getElementById("storeList");
      const storeCount = document.getElementById("storeCount");
      
      storeList.innerHTML = "";
      
      if (list.length === 0) {
        storeList.innerHTML = `<div class="no-results">No salons found matching your search criteria</div>`;
        storeCount.textContent = "0 salons found";
        return;
      }
      
      storeCount.textContent = `${list.length} salon${list.length !== 1 ? 's' : ''} found`;
      
      list.forEach(store => {
        const storeItem = document.createElement("div");
        storeItem.classList.add("store-item");
        storeItem.innerHTML = `
          <h3>${store.Name}</h3>
          <p><i class="fas fa-map-marker-alt"></i> <strong>Address:</strong> ${store.Address}, ${store.City}, ${store.State}, ${store.Zip}</p>
          <p><i class="fas fa-phone"></i> <strong>Phone:</strong> <a href="tel:${store.Phone.replace(/[^\d+]/g, '')}" class="phone-link">${store.Phone}</a></p>
          <div class="store-actions">
            <button class="map-btn" onclick="window.open('${store.maps}', '_blank')">
              <i class="fas fa-directions"></i> Get Directions
            </button>
            <a href="tel:${store.Phone.replace(/[^\d+]/g, '')}" class="call-btn">
              <i class="fas fa-phone"></i> Call Now
            </a>
          </div>
        `;
        storeList.appendChild(storeItem);
      });
    }
    
    // Filter stores based on search input and selected city
    function filterStores() {
      const searchInput = document.getElementById("search").value.toLowerCase().trim();
      const activeFilter = document.querySelector(".filter-btn.active");
      const dropdownFilter = document.getElementById("cityDropdown");
      
      // Get selected city from either buttons or dropdown depending on viewport
      let selectedCity;
      if (window.innerWidth <= 768) {
        selectedCity = dropdownFilter.value;
      } else {
        selectedCity = activeFilter ? activeFilter.dataset.city : "all";
      }
      
      const filteredStores = stores.filter(store => {
        // Filter by search text
        const matchesSearch = 
          store.Name.toLowerCase().includes(searchInput) ||
          store.City.toLowerCase().includes(searchInput) ||
          store.Address.toLowerCase().includes(searchInput) ||
          store.State.toLowerCase().includes(searchInput);
        
        // Filter by selected city
        const matchesCity = selectedCity === "all" || store.City === selectedCity;
        
        return matchesSearch && matchesCity;
      });
      
      displayStores(filteredStores);
    }
    
    // Initialize the app
    function init() {
      createCityFilters();
      displayStores(stores);
      
      // Add event listener to search button
      document.getElementById("searchBtn").addEventListener("click", () => {
        filterStores();
        scrollToStoreList();
      });
      
      // Add event listener to search input for Enter key
      document.getElementById("search").addEventListener("keyup", (event) => {
        if (event.key === "Enter") {
          filterStores();
          scrollToStoreList();
        }
      });
      
      // Sync dropdown with buttons on window resize
      window.addEventListener("resize", () => {
        const activeButton = document.querySelector(".filter-btn.active");
        const dropdown = document.getElementById("cityDropdown");
        
        if (activeButton) {
          dropdown.value = activeButton.dataset.city;
        }
      });
    }
    
    // Start the app when the page loads
    window.onload = init;
  </script>



