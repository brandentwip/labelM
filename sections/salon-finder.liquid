 <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
     
    }
    
    body {
      background-color: #f5f5f5;
      color: #333;
     
    }
    
    .container {
      max-width: 100%;
      margin: 0 auto;
      background: #fff; 
      padding: 30px;
      border-radius: 10px;
      
    }
    
    .brand-logo {
      display: block;
      max-width: 250px;
      margin: 0 auto 30px;
      height: auto;
    }
    
    h2 { 
      text-align: center; 
      margin-bottom: 25px; 
      font-weight: 700;
      font-size: 32px;
      color: #222;
      letter-spacing: 1px;
    }
    
    .search-section {
      display: flex;
      flex-direction: column;
      gap: 15px;
      margin-bottom: 25px;
    }
    
    .search-input-container {
      display: flex;
      width: 100%;
      position: relative;
    }
    
    .search-bar {
      width: 100%;
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 16px;
      transition: all 0.3s ease;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    
    .search-bar:focus {
      outline: none;
      border-color: #555;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .search-btn {
      position: absolute;
      right: 5px;
      top: 50%;
      transform: translateY(-50%);
      background: #333;
      color: white;
      border: none;
      border-radius: 4px;
      padding: 8px 15px;
      cursor: pointer;
      transition: all 0.2s;
    }
    
    .search-btn:hover {
      background: #555;
    }
    
    .filter-section {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }
    
    .filter-btn {
      padding: 8px 15px;
      background: #f0f0f0;
      border: 1px solid #ddd;
      border-radius: 20px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
    }
    
    .filter-btn:hover {
      background: #e0e0e0;
    }
    
    .filter-btn.active {
      background: #333;
      color: white;
      border-color: #333;
    }
    
    .city-dropdown {
      display: none;
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 16px;
      background-color: #fff;
      cursor: pointer;
    }
    
    .city-dropdown:focus {
      outline: none;
      border-color: #555;
    }
    
    .store-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 20px;
      scroll-margin-top: 20px;
    }
    
    .store-item {
      padding: 20px;
      border-radius: 8px;
      background: #f8f8f8;
      transition: all 0.3s;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
      border-left: 4px solid #333;
    }
    
    .store-item:hover { 
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    .store-item h3 {
      margin-bottom: 10px;
      color: #222;
    }
    
    .store-item p {
      margin-bottom: 8px;
      color: #555;
      line-height: 1.5;
    }
    
    .store-actions {
      display: flex;
      margin-top: 15px;
      gap: 10px;
    }
    
    .map-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 15px;
      background: #333;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
    }
    
    .map-btn:hover {
      background: #555;
    }
    
    .map-btn i {
      font-size: 16px;
    }
    
    .store-count {
      margin-bottom: 15px;
      font-size: 14px;
      color: #666;
    }
    
    .no-results {
      text-align: center;
      padding: 30px;
      color: #666;
      font-style: italic;
    }
    
    .phone-link {
      color: #333;
      text-decoration: none;
      transition: color 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    
    .phone-link:hover {
      color: #555;
      text-decoration: underline;
    }
    
    .call-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 15px;
      background: #4CAF50;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
      text-decoration: none;
    }
    .elementor-1473 .elementor-element.elementor-element-31052f4 {
    margin-top: 0px;
    display: none;
    margin-bottom: 0px;
}
    .call-btn:hover {
      background: #45a049;
    }
    
    @media (min-width: 600px) { 
      .store-list { 
        grid-template-columns: repeat(2, 1fr); 
      } 
    }
    
    @media (min-width: 900px) { 
      .store-list { 
        grid-template-columns: repeat(3, 1fr); 
      } 
    }
    
    @media (max-width: 768px) {
      .container {
        padding: 15px;
      }
      
      .brand-logo {
        max-width: 180px;
        margin-bottom: 20px;
      }
      
      h2 {
        font-size: 24px;
      }
      
      .filter-section {
        display: none;
      }
      
      .city-dropdown {
        display: block;
      }
      
      .store-list {
        grid-template-columns: 1fr;
      }
      
      .store-actions {
        flex-direction: column;
      }
      
      .map-btn, .call-btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>


