<section class="labelm-section" id="labelm-categories-{{ section.id }}">
  <div class="labelm-container">
    {% render 'labelm-sec-head',
      kick: section.settings.kick,
      heading: section.settings.heading,
      extra_class: 'labelm-sec-head--compact-top'
    %}

    <div class="labelm-cat-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="labelm-cat-card c{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <div class="labelm-cat-bg">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', alt: block.settings.title
              }}
            {%- endif -%}
          </div>

          {%- if block.settings.badge != blank -%}
            <span class="labelm-cat-off">{{ block.settings.badge }}</span>
          {%- endif -%}

          <div class="labelm-cat-txt">
            <h5>{{ block.settings.title }}</h5>
            {%- if block.settings.subtitle != blank -%}
              <span>{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Label.M Shop by Category",
  "tag": "section",
  "class": "labelm-shop-category-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kick",
      "label": "Eyebrow",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Regime sets, on offer"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category set"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Shop the range"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Offer badge",
          "default": "15% OFF"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Label.M Shop by Category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "M-Plex Bond Repair Set",
            "subtitle": "Rs. 4,500 → Rs. 3,825",
            "badge": "15% OFF"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Amaranth Thickening Set",
            "subtitle": "Rs. 5,100 → Rs. 4,335",
            "badge": "15% OFF"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Nourish & Repair Set",
            "subtitle": "Rs. 4,800 → Rs. 4,080",
            "badge": "15% OFF"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Restorative Masks",
            "subtitle": "Shop the range",
            "badge": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
