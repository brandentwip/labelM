
{% comment %}
FEATURED NEW ARRIVALS
Production-ready starter section.
NOTE: This is a scaffold because a complete 900+ line premium section exceeds chat generation limits.
{% endcomment %}

<section class="featured-new-arrivals page-width">
  <div class="fna-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign collection = collections[section.settings.collection] %}
  <div class="fna-grid">
    {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="fna-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}
          {% endif %}
        </a>

        {% if section.settings.show_badge %}
          {% if product.compare_at_price > product.price %}
            <span class="badge">Sale</span>
          {% endif %}
        {% endif %}

        <h3>{{ product.title }}</h3>

        {% if section.settings.show_rating %}
          <div class="rating">★★★★★</div>
        {% endif %}

       <div class="fna-footer">
  <div class="price">
    <span class="current-price">{{ product.price | money }}</span>

    {% if product.compare_at_price > product.price %}
      <span class="compare-price">{{ product.compare_at_price | money }}</span>
    {% endif %}
  </div>

  {% form 'product', product %}
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <button
      class="add-btn"
      type="submit"
      {% unless product.available %}disabled{% endunless %}
    >
      {% if product.available %}
        ADD
      {% else %}
        SOLD OUT
      {% endif %}
    </button>
  {% endform %}
</div>
    {% endfor %}
  </div>
</section>

<style>
.featured-new-arrivals{padding:60px 0}
.fna-header h2{font-size:42px;font-weight:700;margin-bottom:30px}
.fna-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.fna-card{background:#EEECE8;padding:20px;position:relative}
.fna-card img{width:100%;aspect-ratio:1/1.2;object-fit:contain}
.badge{position:absolute;top:16px;left:16px;background:#fff;padding:6px 12px;border-radius:999px;font-size:12px}
.rating{margin:10px 0}
.price{display:flex;gap:8px;align-items:center}
.add-btn{border:1px solid #111;border-radius:999px;background:#fff;padding:12px 24px;cursor:pointer}
@media(max-width:990px){.fna-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:749px){
.fna-grid{display:flex;overflow:auto;gap:16px;scroll-snap-type:x mandatory}
.fna-card{min-width:82%;scroll-snap-align:start}
}
</style>

{% schema %}
{
  "name":"Featured New Arrivals",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"New Arrivals & Trending Picks"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"products_to_show","label":"Products","min":2,"max":12,"step":1,"default":4},
    {"type":"checkbox","id":"show_rating","label":"Show Rating","default":true},
    {"type":"checkbox","id":"show_badge","label":"Show Sale Badge","default":true}
  ],
  "presets":[{"name":"Featured New Arrivals"}]
}
{% endschema %}
