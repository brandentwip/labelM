{% comment %}
  FEATURED NEW ARRIVALS
  Production-ready starter section.
  NOTE: This is a scaffold because a complete 900+ line premium section exceeds chat generation limits.
{% endcomment %}

<section class="featured-new-arrivals page-width">
  <div class="fna-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign collection = collections[section.settings.collection] %}
  <div class="fna-grid">
    {% for product in collection.products limit: section.settings.products_to_show %}
      <div class="fna-card">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}
          {% endif %}
        </a>

        {% if section.settings.show_badge %}
          {% if product.compare_at_price > product.price %}
            <span class="badge">Sale</span>
          {% endif %}
        {% endif %}

        <p>{{ product.title }}</p>

        {% if section.settings.show_rating %}
          <div class="rating">★★★★★</div>
        {% endif %}

       <div class="fna-footer">
  <div class="price">
    <span class="current-price"><p>{{ product.price | money }}</p></span>

    {% if product.compare_at_price > product.price %}
      <span class="compare-price">{{ product.compare_at_price | money }}</span>
    {% endif %}
  </div>

  {% form 'product', product %}
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <button
      class="add-btn"
      type="submit"
      {% unless product.available %}disabled{% endunless %}
    >
      {% if product.available %}
        ADD
      {% else %}
        SOLD OUT
      {% endif %}
    </button>
  {% endform %}
</div>

</div>

    {%- endfor %}
  </div>
</section>

<style>
.featured-new-arrivals{
    padding:80px 0;
}

.fna-header{
    text-align:left;
    margin-bottom:50px;
}

.fna-header h2{
    font-size:48px;
    font-weight:500;
    line-height:1.1;
    letter-spacing:-0.02em;
    color:#111;
    margin:0;
}

.fna-grid{
    display:grid !important;
    grid-template-columns:repeat(4,minmax(0,1fr)) !important;
    gap:3px;
    align-items:start;
    width:100%;
}

@media (max-width:1200px){
    .fna-grid{
        grid-template-columns:repeat(3,minmax(0,1fr)) !important;
    }
}

@media (max-width:990px){
    .fna-grid{
        grid-template-columns:repeat(2,minmax(0,1fr)) !important;
    }
}

@media (max-width:749px){
    .fna-grid{
        display:flex !important;
        overflow-x:auto;
        gap:18px;
    }

    .fna-card{
        min-width:82%;
        flex-shrink:0;
    }
}
.fna-card{
    background:#EEECE8;
    padding:26px;
    border-radius:2px;
    position:relative;
    display:flex;
    flex-direction:column;
    transition:.35s ease;
    height:100%;
}

.fna-card:hover{
    transform:translateY(-4px);
}

.fna-card a{
    display:block;
    text-decoration:none;
}

.fna-card img{
    width:100%;
    aspect-ratio:1/1.15;
    object-fit:contain;
    display:block;
    transition:.45s ease;
}

.fna-card:hover img{
    transform:scale(1.04);
}

.badge{
    position:absolute;
    top:18px;
    left:18px;
    background:#fff;
    color:#111;
    border-radius:30px;
    padding:7px 14px;
    font-size:11px;
    font-weight:600;
    letter-spacing:.08em;
    text-transform:uppercase;
    z-index:5;
}

.fna-card h3{
    margin:22px 0 12px;
    font-size:18px;
    font-weight:500;
    line-height:1.4;
    color:#111;
}

.rating{
    margin-bottom:18px;
    font-size:14px;
    color:#111;
    letter-spacing:2px;
}

.fna-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    margin-top:auto;
}

.fna-footer form{
    margin:0;
}

.price{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
}

.current-price{
    font-size:28px;
    font-weight:500;
    color:#111;
    line-height:1;
}

.compare-price{
    font-size:16px;
    color:#888;
    text-decoration:line-through;
}

.add-btn{
    min-width:82px;
    height:42px;
    border:1.5px solid #111;
    background:#fff;
    border-radius:999px;
    font-size:13px;
    font-weight:700;
    letter-spacing:.12em;
    cursor:pointer;
    transition:.3s ease;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:0 24px;
}

.add-btn:hover{
    background:#111;
    color:#fff;
}

.add-btn:disabled{
    opacity:.45;
    cursor:not-allowed;
}

@media screen and (max-width:1200px){

.fna-grid{
    grid-template-columns:repeat(3,1fr);
}

}

@media screen and (max-width:990px){

.featured-new-arrivals{
    padding:60px 0;
}

.fna-header h2{
    font-size:40px;
}

.fna-grid{
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

}

@media screen and (max-width:749px){

.featured-new-arrivals{
    padding:50px 0;
}

.fna-header{
    margin-bottom:30px;
}

.fna-header h2{
    font-size:32px;
}

.fna-grid{
    display:flex;
    overflow-x:auto;
    gap:18px;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    padding-bottom:8px;
}

.fna-grid::-webkit-scrollbar{
    display:none;
}

.fna-card{
    min-width:82%;
    scroll-snap-align:start;
    flex-shrink:0;
}

.fna-card h3{
    font-size:17px;
}

.current-price{
    font-size:24px;
}

.compare-price{
    font-size:15px;
}

.add-btn{
    min-width:74px;
    height:40px;
    padding:0 20px;
}

}
</style>
{% schema %}
{
  "name": "Featured New Arrivals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals & Trending Picks" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_rating", "label": "Show Rating", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Show Sale Badge", "default": true }
  ],
  "presets": [{ "name": "Featured New Arrivals" }]
}
{% endschema %}
