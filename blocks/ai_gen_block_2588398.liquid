{% doc %}
  @prompt
    create a section having 5 images horizontally placed and a text below each of them in adjustable fonts , there should have space in right and left of the section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-grid-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .ai-image-grid-item-{{ ai_gen_id }} {
    flex: 1 1 calc(20% - {{ block.settings.item_spacing }}px);
    min-width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-image-grid-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.text_spacing }}px;
    position: relative;
  }

  .ai-image-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-grid-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-image-grid-item-{{ ai_gen_id }} {
      flex: 1 1 calc(33.333% - {{ block.settings.item_spacing }}px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-image-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px;
    }

    .ai-image-grid-item-{{ ai_gen_id }} {
      flex: 1 1 calc(50% - {{ block.settings.item_spacing }}px);
    }

    .ai-image-grid-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-grid-container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign text_key = 'text_' | append: i
        assign image = block.settings[image_key]
        assign text = block.settings[text_key]
      %}
      
      <div class="ai-image-grid-item-{{ ai_gen_id }}">
        <div class="ai-image-grid-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-image-grid-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-image-grid-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        {% if text != blank %}
          <p class="ai-image-grid-text-{{ ai_gen_id }}">{{ text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

