{% doc %}
  @prompt
    A refreshing, sparkling citrus scent with notes of grapefruit zest and sugared mint
    An instant boost of salon-fresh energy
    Free Of Sulphates, Silicones, Protein, Phthalates, Phosphate and Parabens "also create a key beifits section like this", Grey bg
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-key-benefits-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-key-benefits-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.inner_padding }}px;
  }

  .ai-key-benefits-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-key-benefits-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-key-benefits-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-key-benefits-item-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.item_alignment }};
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-key-benefits-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-key-benefits-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-key-benefits-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-key-benefits-list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-key-benefits-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-key-benefits-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-key-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-key-benefits-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-key-benefits-header-{{ ai_gen_id }}">
        <h2 class="ai-key-benefits-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <ul class="ai-key-benefits-list-{{ ai_gen_id }}">
      {% if block.settings.benefit_1_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</p>
        </li>
      {% endif %}

      {% if block.settings.benefit_2_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</p>
        </li>
      {% endif %}

      {% if block.settings.benefit_3_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</p>
        </li>
      {% endif %}

      {% if block.settings.benefit_4_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</p>
        </li>
      {% endif %}

      {% if block.settings.benefit_5_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_5_text }}</p>
        </li>
      {% endif %}

      {% if block.settings.benefit_6_text != blank %}
        <li class="ai-key-benefits-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <div class="ai-key-benefits-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          {% endif %}
          <p class="ai-key-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_6_text }}</p>
        </li>
      {% endif %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Key benefits",
  "settings": [
    {
      "type": "header",
      "content": "Section title"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "Key Benefits"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Title case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Title bottom spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "textarea",
      "id": "benefit_1_text",
      "label": "Benefit 1",
      "default": "A refreshing, sparkling citrus scent with notes of grapefruit zest and sugared mint"
    },
    {
      "type": "textarea",
      "id": "benefit_2_text",
      "label": "Benefit 2",
      "default": "An instant boost of salon-fresh energy"
    },
    {
      "type": "textarea",
      "id": "benefit_3_text",
      "label": "Benefit 3",
      "default": "Free of sulphates, silicones, protein, phthalates, phosphate and parabens"
    },
    {
      "type": "textarea",
      "id": "benefit_4_text",
      "label": "Benefit 4"
    },
    {
      "type": "textarea",
      "id": "benefit_5_text",
      "label": "Benefit 5"
    },
    {
      "type": "textarea",
      "id": "benefit_6_text",
      "label": "Benefit 6"
