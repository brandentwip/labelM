{% doc %}
  @prompt
    make a responsive dual banner section, the banners must have fit image option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-dual-banner-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-dual-banner-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-dual-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
  }

  .ai-dual-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-dual-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-dual-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-dual-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-dual-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    z-index: 1;
  }

  .ai-dual-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-dual-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.4;
  }

  .ai-dual-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
    margin-top: {{ block.settings.text_spacing }}px;
  }

  .ai-dual-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-dual-banner-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-banner-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-dual-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-dual-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-dual-banner-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<dual-banner-{{ ai_gen_id }} class="ai-dual-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-banner-container-{{ ai_gen_id }}">
    <div class="ai-dual-banner-item-{{ ai_gen_id }}">
      {% if block.settings.image_1 %}
        <img
          src="{{ block.settings.image_1 | image_url: width: 1200 }}"
          alt="{{ block.settings.image_1.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_1.width }}"
          height="{{ block.settings.image_1.height }}"
          class="ai-dual-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-dual-banner-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-dual-banner-empty-state-{{ ai_gen_id }}">
            Add image for banner 1
          </div>
        </div>
      {% endif %}

      <div class="ai-dual-banner-overlay-{{ ai_gen_id }}"></div>

      <div class="ai-dual-banner-content-{{ ai_gen_id }}">
        {% if block.settings.heading_1 != blank %}
          <h2 class="ai-dual-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h2>
        {% endif %}

        {% if block.settings.subheading_1 != blank %}
          <p class="ai-dual-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading_1 }}</p>
        {% endif %}

        {% if block.settings.button_text_1 != blank and block.settings.button_link_1 != blank %}
          <a href="{{ block.settings.button_link_1 }}" class="ai-dual-banner-button-{{ ai_gen_id }}">
            {{ block.settings.button_text_1 }}
          </a>
        {% endif %}
      </div>

      {% if block.settings.link_1 != blank %}
        <a href="{{ block.settings.link_1 }}" class="ai-dual-banner-link-{{ ai_gen_id }}" aria-label="{{ block.settings.heading_1 | default: 'Banner 1' }}"></a>
      {% endif %}
    </div>

    <div class="ai-dual-banner-item-{{ ai_gen_id }}">
      {% if block.settings.image_2 %}
        <img
          src="{{ block.settings.image_2 | image_url: width: 1200 }}"
          alt="{{ block.settings.image_2.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_2.width }}"
          height="{{ block.settings.image_2.height }}"
          class="ai-dual-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-dual-banner-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-dual-banner-empty-state-{{ ai_gen_id }}">
            Add image for banner 2
          </div>
        </div>
      {% endif %}

      <div class="ai-dual-banner-overlay-{{ ai_gen_id }}"></div>

      <div class="ai-dual-banner-content-{{ ai_gen_id }}">
        {% if block.settings.heading_2 != blank %}
          <h2 class="ai-dual-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h2>
        {% endif %}

        {% if block.settings.subheading_2 != blank %}
          <p class="ai-dual-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading_2 }}</p>
        {% endif %}

        {% if block.settings.button_text_2 != blank and block.settings.button_link_2 != blank %}
          <a href="{{ block.settings.button_link_2 }}" class="ai-dual-banner-button-{{ ai_gen_id }}">
            {{ block.settings.button_text_2 }}
          </a>
        {% endif %}
      </div>

      {% if block.settings.link_2 != blank %}
        <a href="{{ block.settings.link_2 }}" class="ai-dual-banner-link-{{ ai_gen_id }}" aria-label="{{ block.settings.heading_2 | default: 'Banner 2' }}"></a>
      {% endif %}
    </div>
  </div>
</dual-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class DualBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('dual-banner-{{ ai_gen_id }}', DualBanner{{ ai_gen_id }});
  })();
</script>

