{% doc %}
  @prompt
    I wanna have a section consists of 3 boxes aligned edge to edge horizontally which works as a collection card and I will upload the image to them. it should be responsive
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-cards-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-cards__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
  }

  .ai-collection-cards__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-collection-cards__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-collection-cards__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-collection-cards__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-collection-cards__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-collection-cards__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-cards__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: {{ block.settings.text_padding }}px;
    transition: background 0.3s ease;
  }

  .ai-collection-cards__link-{{ ai_gen_id }}:hover .ai-collection-cards__overlay-{{ ai_gen_id }} {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 | plus: 0.2 }}) 100%
    );
  }

  .ai-collection-cards__content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-collection-cards__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-collection-cards__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 8px 0 0;
    line-height: 1.4;
    opacity: 0.9;
  }

  .ai-collection-cards__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-cards__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-cards__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-collection-cards__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.8 }}px;
    }

    .ai-collection-cards__overlay-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-cards__grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign description_key = 'description_' | append: i

        assign collection = block.settings[collection_key]
        assign custom_image = block.settings[image_key]
        assign custom_title = block.settings[title_key]
        assign custom_description = block.settings[description_key]

        if collection != blank
          assign link_url = collection.url
          assign display_title = collection.title
          assign display_image = collection.featured_image
        else
          assign link_url = '#'
          assign display_title = custom_title
          assign display_image = custom_image
        endif

        if custom_image != blank
          assign display_image = custom_image
        endif

        if custom_title != blank
          assign display_title = custom_title
        endif
      %}

      <div class="ai-collection-cards__item-{{ ai_gen_id }}">
        <a href="{{ link_url }}" class="ai-collection-cards__link-{{ ai_gen_id }}">
          <div class="ai-collection-cards__image-wrapper-{{ ai_gen_id }}">
            {% if display_image != blank %}
              <img
                src="{{ display_image | image_url: width: 800 }}"
                alt="{{ display_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-cards__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-cards__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
                {% if collection == blank %}
                  <div class="ai-collection-cards__empty-state-{{ ai_gen_id }}">
                    Add collection or image
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>

          <div class="ai-collection-cards__overlay-{{ ai_gen_id }}">
            <div class="ai-collection-cards__content-{{ ai_gen_id }}">
              {% if display_title != blank %}
                <h3 class="ai-collection-cards__title-{{ ai_gen_id }}">{{ display_title }}</h3>
              {% endif %}
              {% if custom_description != blank %}
                <p class="ai-collection-cards__description-{{ ai_gen_id }}">{{ custom_description }}</p>
              {% endif %}
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

