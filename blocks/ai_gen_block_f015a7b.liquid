    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Custom image"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Custom title"
    },
    {
      "type": "text",
      "id": "description_2",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Custom image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Custom title"
    },
    {
      "type": "text",
      "id": "description_3",
      "label": "Description"
