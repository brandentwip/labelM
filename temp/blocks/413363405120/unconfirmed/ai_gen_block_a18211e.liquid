{% doc %}
  @prompt
    Create a custom Shopify section called "Featured Product Showcase" with the following layout:LEFT SIDE:- A product card showing: product image, product title, star rating (using metafield or static stars), price, and left/right arrow navigation buttons to cycle through a list of selected products (configurable in theme editor)- Navigation arrows (< >) below the product card to switch between products- A short decorative line/dash below the arrowsRIGHT SIDE:- Two static images side by side (or stacked on mobile), configurable in the theme editor- These images do not change when navigating productsHEADER:- A large bold heading text at the top left (e.g. "MEET THE NEW LABEL.M HUMID-DEFY MIST"), configurable in theme editor- Navigation arrows (< >) at the top right of the section to also cycle through productsDESIGN:- Clean white background- Minimal, editorial style- Product title in small caps/uppercase- Price displayed below title- Star rating display (5 stars, filled based on rating)MOBILE RESPONSIVE:- On mobile: stack layout vertically — heading, then product card, then the two images below- Images should be full width on mobile- Navigation arrows should remain accessible on mobileSETTINGS (configurable in theme editor):- Section heading text- Up to 6 products selectable (product picker)- 2 static image pickers (right side images)- Image alt text fields
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign products_array = block.settings.products | split: ','
  assign total_products = 0
  for i in (1..6)
    assign product_key = 'product_' | append: i
    if block.settings[product_key] != blank
      assign total_products = total_products | plus: 1
    endif
  endfor
%}

{% style %}
  .ai-featured-showcase-{{ ai_gen_id }} {
    display: block;
    background-color: #ffffff;
    padding: 60px 20px;
    width: 100%;
  }

  .ai-featured-showcase-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-featured-showcase-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
    gap: 20px;
  }

  .ai-featured-showcase-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .ai-featured-showcase-header-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-featured-showcase-nav-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border: 1px solid #000000;
    background-color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    border-radius: 4px;
  }

  .ai-featured-showcase-nav-button-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-featured-showcase-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-showcase-nav-button-{{ ai_gen_id }}:disabled:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .ai-featured-showcase-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-featured-showcase-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-featured-showcase-product-card-{{ ai_gen_id }} {
    display: none;
  }

  .ai-featured-showcase-product-card-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-featured-showcase-product-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 20px;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-featured-showcase-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-showcase-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-showcase-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-featured-showcase-product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ai-featured-showcase-product-title-{{ ai_gen_id }} a {
    color: #000000;
    text-decoration: none;
  }

  .ai-featured-showcase-product-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-featured-showcase-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-featured-showcase-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: #000000;
  }

  .ai-featured-showcase-star-{{ ai_gen_id }}.empty {
    fill: #e0e0e0;
  }

  .ai-featured-showcase-product-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .ai-featured-showcase-product-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-featured-showcase-divider-{{ ai_gen_id }} {
    width: 60px;
    height: 2px;
    background-color: #000000;
  }

  .ai-featured-showcase-right-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .ai-featured-showcase-static-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-featured-showcase-static-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-showcase-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ai-featured-showcase-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-featured-showcase-header-{{ ai_gen_id }} {
      flex-direction: column;
      margin-bottom: 30px;
    }

    .ai-featured-showcase-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-featured-showcase-header-nav-{{ ai_gen_id }} {
      align-self: flex-start;
    }

    .ai-featured-showcase-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-featured-showcase-right-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-featured-showcase-nav-button-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }
  }
{% endstyle %}

<featured-product-showcase-{{ ai_gen_id }}
  class="ai-featured-showcase-{{ ai_gen_id }}"
  data-total-products="{{ total_products }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-showcase-container-{{ ai_gen_id }}">
    <div class="ai-featured-showcase-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-featured-showcase-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      
      <div class="ai-featured-showcase-header-nav-{{ ai_gen_id }}">
        <button
          class="ai-featured-showcase-nav-button-{{ ai_gen_id }} ai-featured-showcase-prev-{{ ai_gen_id }}"
          aria-label="Previous product"
          data-nav="prev"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 4L6 10L12 16"/>
          </svg>
        </button>
        <button
          class="ai-featured-showcase-nav-button-{{ ai_gen_id }} ai-featured-showcase-next-{{ ai_gen_id }}"
          aria-label="Next product"
          data-nav="next"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 4L14 10L8 16"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-featured-showcase-content-{{ ai_gen_id }}">
      <div class="ai-featured-showcase-left-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
          %}
          
          {% if product != blank %}
            <div
              class="ai-featured-showcase-product-card-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-product-index="{{ i }}"
            >
              <div class="ai-featured-showcase-product-image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-featured-showcase-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <h3 class="ai-featured-showcase-product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="ai-featured-showcase-rating-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  {% if star <= block.settings.star_rating %}
                    <svg class="ai-featured-showcase-star-{{ ai_gen_id }}" viewBox="0 0 20 20">
                      <path d="M10 1L12.5 7.5L19 8.5L14.5 13L15.5 19L10 16L4.5 19L5.5 13L1 8.5L7.5 7.5L10 1Z"/>
                    </svg>
                  {% else %}
                    <svg class="ai-featured-showcase-star-{{ ai_gen_id }} empty" viewBox="0 0 20 20">
                      <path d="M10 1L12.5 7.5L19 8.5L14.5 13L15.5 19L10 16L4.5 19L5.5 13L1 8.5L7.5 7.5L10 1Z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>

              <div class="ai-featured-showcase-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <div class="ai-featured-showcase-product-nav-{{ ai_gen_id }}">
                <button
                  class="ai-featured-showcase-nav-button-{{ ai_gen_id }}"
                  aria-label="Previous product"
                  data-nav="prev"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 4L6 10L12 16"/>
                  </svg>
                </button>
                <button
                  class="ai-featured-showcase-nav-button-{{ ai_gen_id }}"
                  aria-label="Next product"
                  data-nav="next"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 4L14 10L8 16"/>
                  </svg>
                </button>
              </div>

              <div class="ai-featured-showcase-divider-{{ ai_gen_id }}"></div>
            </div>
          {% endif %}
        {% endfor %}

        {% if total_products == 0 %}
          <div class="ai-featured-showcase-product-card-{{ ai_gen_id }} active">
            <div class="ai-featured-showcase-product-image-{{ ai_gen_id }}">
              <div class="ai-featured-showcase-image-placeholder-{{ ai_gen_id }}" style="position: relative;">
                {{ 'product-1' | placeholder_svg_tag }}
                <div class="ai-featured-showcase-empty-state-{{ ai_gen_id }}">
                  Next, add products to showcase
                </div>
              </div>
            </div>
            <h3 class="ai-featured-showcase-product-title-{{ ai_gen_id }}">Product title</h3>
            <div class="ai-featured-showcase-rating-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-featured-showcase-star-{{ ai_gen_id }}" viewBox="0 0 20 20">
                  <path d="M10 1L12.5 7.5L19 8.5L14.5 13L15.5 19L10 16L4.5 19L5.5 13L1 8.5L7.5 7.5L10 1Z"/>
                </svg>
              {% endfor %}
            </div>
            <div class="ai-featured-showcase-product-price-{{ ai_gen_id }}">₹0.00</div>
          </div>
        {% endif %}
      </div>

      <div class="ai-featured-showcase-right-{{ ai_gen_id }}">
        <div class="ai-featured-showcase-static-image-{{ ai_gen_id }}">
          {% if block.settings.static_image_1 %}
            <img
              src="{{ block.settings.static_image_1 | image_url: width: 600 }}"
              alt="{{ block.settings.static_image_1_alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <div class="ai-featured-showcase-image-placeholder-{{ ai_gen_id }}" style="position: relative;">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-featured-showcase-empty-state-{{ ai_gen_id }}">
                Add image 1
              </div>
            </div>
          {% endif %}
        </div>

        <div class="ai-featured-showcase-static-image-{{ ai_gen_id }}">
          {% if block.settings.static_image_2 %}
            <img
              src="{{ block.settings.static_image_2 | image_url: width: 600 }}"
              alt="{{ block.settings.static_image_2_alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <div class="ai-featured-showcase-image-placeholder-{{ ai_gen_id }}" style="position: relative;">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-featured-showcase-empty-state-{{ ai_gen_id }}">
                Add image 2
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</featured-product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 1;
        this.totalProducts = parseInt(this.dataset.totalProducts) || 0;
      }

      connectedCallback() {
        if (this.totalProducts === 0) return;

        this.productCards = this.querySelectorAll('.ai-featured-showcase-product-card-{{ ai_gen_id }}');
        this.navButtons = this.querySelectorAll('[data-nav]');
        
        this.setupEventListeners();
        this.updateNavButtons();
      }

      setupEventListeners() {
        this.navButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const direction = e.currentTarget.dataset.nav;
            if (direction === 'next') {
              this.nextProduct();
            } else {
              this.prevProduct();
            }
          });
        });
      }

      nextProduct() {
        if (this.currentIndex < this.totalProducts) {
          this.currentIndex++;
          this.showProduct(this.currentIndex);
        }
      }

      prevProduct() {
        if (this.currentIndex > 1) {
          this.currentIndex--;
          this.showProduct(this.currentIndex);
        }
      }

      showProduct(index) {
        this.productCards.forEach(card => {
          card.classList.remove('active');
        });

        const activeCard = this.querySelector(`[data-product-index="${index}"]`);
        if (activeCard) {
          activeCard.classList.add('active');
        }

        this.updateNavButtons();
      }

      updateNavButtons() {
        const prevButtons = this.querySelectorAll('[data-nav="prev"]');
        const nextButtons = this.querySelectorAll('[data-nav="next"]');

        prevButtons.forEach(btn => {
          btn.disabled = this.currentIndex === 1;
        });

        nextButtons.forEach(btn => {
          btn.disabled = this.currentIndex === this.totalProducts;
        });
      }
    }

    customElements.define('featured-product-showcase-{{ ai_gen_id }}', FeaturedProductShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured product showcase",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Meet the new Label.M humid-defy mist"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Static images"
    },
    {
      "type": "image_picker",
      "id": "static_image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "static_image_1_alt",
      "label": "Image 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "static_image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "static_image_2_alt",
      "label": "Image 2 alt text"
    }
  ],
  "presets": [
    {
      "name": "Featured product showcase"
    }
  ]
}
{% endschema %}
